{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agents-kit/schemas/pack.schema.json",
  "title": "Pack Schema",
  "description": "Schema for validating pack.yaml",
  "type": "object",
  "required": ["id", "name", "version", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique identifier for the pack"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Human-readable name for the pack"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 0.10.0)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Description of what the pack contains"
    },
    "author": {
      "type": "string",
      "description": "Author or team name"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "List of skill IDs included in this pack"
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "List of workflow IDs included in this pack"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other packs this pack depends on"
    }
  },
  "additionalProperties": false
}
