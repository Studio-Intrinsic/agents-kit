{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agents-kit/schemas/workflow.schema.json",
  "title": "Workflow Schema",
  "description": "Schema for validating workflow frontmatter",
  "type": "object",
  "required": ["id", "name", "version", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^workflow\\.[a-z][a-z0-9-]*$",
      "description": "Unique identifier prefixed with 'workflow.' (e.g., workflow.plan)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Human-readable name for the workflow"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Description of what the workflow does"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commands or phrases that trigger this workflow"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills this workflow may invoke"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Named phases of the workflow"
    }
  },
  "additionalProperties": false
}
