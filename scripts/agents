#!/usr/bin/env bash
set -euo pipefail

# agents - CLI for managing model-agnostic skills
# Usage: agents <command> [options]

# Resolve symlinks to get the actual script location
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
AGENTS_HOME="${AGENTS_HOME:-$HOME/.agents}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

show_help() {
    cat <<EOF
agents - Model-Agnostic Skills Library CLI

USAGE:
    agents <command> [options]

COMMANDS:
    init [--from <url>]     Initialize ~/.agents/ structure
    render                  Render all packs to build/
      --pack <name>         Render specific pack only
      --runtime <name>      Render for specific runtime only
    install                 Install rendered outputs to tools
      --runtime <name>      Install for specific runtime only
    link                    Symlink mode for development
    list                    List installed packs and skills
    add <pack>              Add pack to project
    update                  Update to latest versions
    lock                    Generate agents.lock
    new skill <name>        Create skill from template
    new pack <name>         Create pack from template
    validate                Check all schemas
    test                    Run tests
    compound                Extract learnings, propose updates

OPTIONS:
    -h, --help              Show this help message
    -v, --version           Show version

EXAMPLES:
    agents init
    agents render --runtime claude-code
    agents install
    agents new skill my-skill
    agents validate
EOF
}

cmd_init() {
    local from_url=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --from)
                from_url="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    log_info "Initializing agents environment..."

    # Create directory structure
    mkdir -p "$AGENTS_HOME"/{config,repos,build/{claude-code,codex},bin}

    # Create config file if not exists
    if [[ ! -f "$AGENTS_HOME/config.yaml" ]]; then
        cat > "$AGENTS_HOME/config.yaml" <<EOF
# agents configuration
version: 1
repos: []
default_runtime: claude-code
EOF
        log_success "Created $AGENTS_HOME/config.yaml"
    fi

    # Clone repo if URL provided
    if [[ -n "$from_url" ]]; then
        log_info "Cloning from $from_url..."
        local repo_name
        repo_name=$(basename "$from_url" .git)
        git clone "$from_url" "$AGENTS_HOME/repos/$repo_name"

        # Add to config
        # This is a simple append; a real implementation would use yq or similar
        echo "  - $AGENTS_HOME/repos/$repo_name" >> "$AGENTS_HOME/config.yaml"
        log_success "Cloned and registered $repo_name"
    fi

    log_success "Initialized $AGENTS_HOME"
}

cmd_render() {
    local pack=""
    local runtime=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --pack)
                pack="$2"
                shift 2
                ;;
            --runtime)
                runtime="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    log_info "Rendering skills..."

    # Call the render script
    "$SCRIPT_DIR/render" ${pack:+--pack "$pack"} ${runtime:+--runtime "$runtime"}
}

cmd_install() {
    local runtime=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --runtime)
                runtime="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    log_info "Installing skills..."

    # Call the install script
    "$SCRIPT_DIR/install" ${runtime:+--runtime "$runtime"}
}

cmd_link() {
    log_info "Creating symlinks for development..."
    "$SCRIPT_DIR/install" --link
}

cmd_list() {
    log_info "Installed packs:"

    for pack_dir in "$REPO_ROOT/.agents/packs"/*; do
        if [[ -d "$pack_dir" ]]; then
            local pack_name
            pack_name=$(basename "$pack_dir")
            local version
            version=$(grep "^version:" "$pack_dir/pack.yaml" 2>/dev/null | cut -d' ' -f2 || echo "unknown")
            echo "  $pack_name ($version)"

            # List skills
            if [[ -d "$pack_dir/skills" ]]; then
                for skill_dir in "$pack_dir/skills"/*; do
                    if [[ -d "$skill_dir" ]]; then
                        echo "    - $(basename "$skill_dir")"
                    fi
                done
            fi

            # List workflows
            if [[ -d "$pack_dir/workflows" ]]; then
                for workflow in "$pack_dir/workflows"/*.md; do
                    if [[ -f "$workflow" ]]; then
                        echo "    - workflow.$(basename "$workflow" .md)"
                    fi
                done
            fi
        fi
    done
}

cmd_new() {
    local type="$1"
    local name="$2"

    case $type in
        skill)
            local skill_dir="$REPO_ROOT/.agents/packs/ak-core/skills/$name"
            mkdir -p "$skill_dir"

            cat > "$skill_dir/skill.md" <<EOF
---
id: $name
name: $(echo "$name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')
version: 1.0.0
description: |
  [Description of what this skill does]
  [When to use it]
tags: [core]
inputs:
  - name: input
    type: string
    required: true
    description: [Input description]
outputs:
  - name: output
    type: markdown
    description: [Output description]
constraints:
  - [Constraint 1]
---

# $(echo "$name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')

## Intent
[What this skill accomplishes]

## Procedure
1. [Step 1]
2. [Step 2]

## Failure Modes
- [What can go wrong]

## Examples

### Input
[Example input]

### Output
[Example output]
EOF
            log_success "Created skill at $skill_dir/skill.md"
            ;;
        pack)
            local pack_dir="$REPO_ROOT/.agents/packs/$name"
            mkdir -p "$pack_dir"/{skills,workflows,tests}

            cat > "$pack_dir/pack.yaml" <<EOF
id: $name
name: $(echo "$name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1') Pack
version: 0.1.0
description: [Pack description]
author: your-team

skills: []
workflows: []
dependencies: []
EOF
            log_success "Created pack at $pack_dir"
            ;;
        *)
            log_error "Unknown type: $type. Use 'skill' or 'pack'"
            exit 1
            ;;
    esac
}

cmd_validate() {
    log_info "Validating schemas..."
    "$SCRIPT_DIR/lint"
}

cmd_test() {
    log_info "Running tests..."

    # Run validation first
    cmd_validate

    # Run any pack-specific tests
    for test_dir in "$REPO_ROOT/.agents/packs"/*/tests; do
        if [[ -d "$test_dir" ]]; then
            log_info "Running tests in $test_dir"
            # Placeholder for test execution
        fi
    done

    log_success "All tests passed"
}

cmd_compound() {
    log_info "Starting compound workflow..."
    log_info "Reviewing session for reusable insights..."

    cat <<EOF

## Compound Workflow

This workflow reviews your recent work session and proposes:
1. New skills
2. Updates to existing skills
3. New patterns/rubrics

To complete compounding:
1. Review your recent work
2. Identify patterns worth capturing
3. Use 'agents new skill <name>' to create proposals
4. Submit PR for team review

EOF
}

cmd_update() {
    log_info "Updating to latest versions..."

    # Pull latest from registered repos
    for repo_dir in "$AGENTS_HOME/repos"/*; do
        if [[ -d "$repo_dir/.git" ]]; then
            log_info "Updating $(basename "$repo_dir")..."
            git -C "$repo_dir" pull --ff-only
        fi
    done

    log_success "Updated all repos"
}

cmd_lock() {
    log_info "Generating lock file..."

    local commit
    commit=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")

    cat > "$REPO_ROOT/agents.lock" <<EOF
# Auto-generated lock file
schema_version: 1
locked_at: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
commit: $commit

packs:
EOF

    for pack_dir in "$REPO_ROOT/.agents/packs"/*; do
        if [[ -d "$pack_dir" && -f "$pack_dir/pack.yaml" ]]; then
            local pack_name
            pack_name=$(basename "$pack_dir")
            local version
            version=$(grep "^version:" "$pack_dir/pack.yaml" | cut -d' ' -f2)
            cat >> "$REPO_ROOT/agents.lock" <<EOF
  $pack_name:
    version: $version
    commit: $commit
EOF
        fi
    done

    log_success "Generated agents.lock"
}

# Main entry point
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case $command in
        init)
            cmd_init "$@"
            ;;
        render)
            cmd_render "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        link)
            cmd_link "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        add)
            log_warn "Not yet implemented"
            ;;
        update)
            cmd_update "$@"
            ;;
        lock)
            cmd_lock "$@"
            ;;
        new)
            cmd_new "$@"
            ;;
        validate)
            cmd_validate "$@"
            ;;
        test)
            cmd_test "$@"
            ;;
        compound)
            cmd_compound "$@"
            ;;
        -h|--help|help)
            show_help
            ;;
        -v|--version)
            echo "agents version 0.1.0"
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
