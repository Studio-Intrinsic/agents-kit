#!/usr/bin/env bash
set -euo pipefail

# lint - Validate skills, workflows, and packs against schemas

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
SCHEMA_DIR="$REPO_ROOT/.agents/schema"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

errors=0

# Check if a skill.md has required frontmatter fields
validate_skill() {
    local file="$1"
    local skill_name
    skill_name=$(basename "$(dirname "$file")")

    # Required fields
    local required_fields=("id" "name" "version" "description")

    for field in "${required_fields[@]}"; do
        if ! grep -q "^$field:" "$file"; then
            log_error "Skill '$skill_name': missing required field '$field'"
            ((errors++))
        fi
    done

    # Check version format
    local version
    version=$(sed -n '/^---$/,/^---$/p' "$file" | grep "^version:" | sed 's/^version: *//')
    if [[ -n "$version" && ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log_error "Skill '$skill_name': version '$version' is not semver format"
        ((errors++))
    fi

    # Check id format
    local id
    id=$(sed -n '/^---$/,/^---$/p' "$file" | grep "^id:" | sed 's/^id: *//')
    if [[ -n "$id" && ! "$id" =~ ^[a-z][a-z0-9-]*$ ]]; then
        log_error "Skill '$skill_name': id '$id' must be lowercase with hyphens only"
        ((errors++))
    fi

    # Check for required sections in body
    if ! grep -q "^## Intent" "$file"; then
        log_warn "Skill '$skill_name': missing '## Intent' section"
    fi
    if ! grep -q "^## Procedure" "$file"; then
        log_warn "Skill '$skill_name': missing '## Procedure' section"
    fi

    if [[ $errors -eq 0 ]]; then
        log_success "Skill '$skill_name' is valid"
    fi
}

# Check if a workflow.md has required fields
validate_workflow() {
    local file="$1"
    local workflow_name
    workflow_name=$(basename "$file" .md)

    local required_fields=("id" "name" "version" "description")

    for field in "${required_fields[@]}"; do
        if ! grep -q "^$field:" "$file"; then
            log_error "Workflow '$workflow_name': missing required field '$field'"
            ((errors++))
        fi
    done

    # Check id format for workflows (should be workflow.*)
    local id
    id=$(sed -n '/^---$/,/^---$/p' "$file" | grep "^id:" | sed 's/^id: *//')
    if [[ -n "$id" && ! "$id" =~ ^workflow\.[a-z][a-z0-9-]*$ ]]; then
        log_error "Workflow '$workflow_name': id '$id' must match 'workflow.<name>' format"
        ((errors++))
    fi

    if [[ $errors -eq 0 ]]; then
        log_success "Workflow '$workflow_name' is valid"
    fi
}

# Check pack.yaml
validate_pack() {
    local file="$1"
    local pack_name
    pack_name=$(basename "$(dirname "$file")")

    local required_fields=("id" "name" "version" "description")

    for field in "${required_fields[@]}"; do
        if ! grep -q "^$field:" "$file"; then
            log_error "Pack '$pack_name': missing required field '$field'"
            ((errors++))
        fi
    done

    # Check that listed skills exist
    local skills_line
    skills_line=$(grep -A100 "^skills:" "$file" | grep "^  - " | sed 's/^  - //')
    for skill in $skills_line; do
        if [[ ! -d "$(dirname "$file")/skills/$skill" ]]; then
            log_warn "Pack '$pack_name': skill '$skill' listed but directory not found"
        fi
    done

    if [[ $errors -eq 0 ]]; then
        log_success "Pack '$pack_name' is valid"
    fi
}

# Check for duplicate IDs across all skills
check_unique_ids() {
    log_info "Checking for duplicate IDs..."

    local ids=()

    for skill_file in "$REPO_ROOT/.agents/packs"/*/skills/*/skill.md; do
        if [[ -f "$skill_file" ]]; then
            local id
            id=$(sed -n '/^---$/,/^---$/p' "$skill_file" | grep "^id:" | sed 's/^id: *//')
            if [[ -n "$id" ]]; then
                for existing_id in "${ids[@]:-}"; do
                    if [[ "$existing_id" == "$id" ]]; then
                        log_error "Duplicate skill ID: '$id'"
                        ((errors++))
                    fi
                done
                ids+=("$id")
            fi
        fi
    done

    if [[ $errors -eq 0 ]]; then
        log_success "All skill IDs are unique"
    fi
}

# Main
main() {
    log_info "Validating agents-kit..."

    # Validate all packs
    for pack_yaml in "$REPO_ROOT/.agents/packs"/*/pack.yaml; do
        if [[ -f "$pack_yaml" ]]; then
            validate_pack "$pack_yaml"
        fi
    done

    # Validate all skills
    for skill_file in "$REPO_ROOT/.agents/packs"/*/skills/*/skill.md; do
        if [[ -f "$skill_file" ]]; then
            validate_skill "$skill_file"
        fi
    done

    # Validate all workflows
    for workflow_file in "$REPO_ROOT/.agents/packs"/*/workflows/*.md; do
        if [[ -f "$workflow_file" ]]; then
            validate_workflow "$workflow_file"
        fi
    done

    # Check for duplicates
    check_unique_ids

    echo ""
    if [[ $errors -gt 0 ]]; then
        log_error "Validation failed with $errors error(s)"
        exit 1
    else
        log_success "All validations passed"
    fi
}

main "$@"
